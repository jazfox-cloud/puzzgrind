{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puzzgrind",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "puzzgrind-staging",
      "vars": {
        "ALLOW_STAGING_PUZZLE_FALLBACK": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "puzzgrind-staging-db",
          "database_id": "d3f0b3d8-81a8-40de-96f4-7ed248e0fb93",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
