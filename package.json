{
  "name": "puzzgrind",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:cloudflare:ci": "node scripts/build-cloudflare-ci.mjs",
    "build:cloudflare:preview": "node scripts/build-cloudflare-artifact.mjs preview",
    "build:cloudflare:production": "node scripts/build-cloudflare-artifact.mjs production",
    "build:cloudflare:staging": "node scripts/build-cloudflare-artifact.mjs staging",
    "validate:artifact:production": "node scripts/validate-cloudflare-artifact.mjs production",
    "preview": "pnpm build:cloudflare:preview && opennextjs-cloudflare preview",
    "deploy": "node scripts/deploy-cloudflare-production.mjs",
    "deploy:staging": "node scripts/build-cloudflare-artifact.mjs staging && opennextjs-cloudflare deploy --env staging",
    "d1:migrate:local": "wrangler d1 migrations apply puzzgrind-staging-db --local --env staging",
    "d1:lexi:seed:local": "node scripts/seed-lexi-development.mjs",
    "d1:lexi:seed:staging": "node scripts/seed-lexi-staging.mjs",
    "d1:sudoku:seed:staging": "node scripts/seed-sudoku-staging.mjs",
    "d1:lexi:setup:local": "pnpm d1:migrate:local && pnpm d1:lexi:seed:local",
    "d1:migrate:staging": "node scripts/apply-lexi-staging-migration.mjs",
    "d1:migrate:production": "node scripts/apply-lexi-production-migration.mjs",
    "d1:lexi:seed:production": "node scripts/seed-lexi-production.mjs",
    "lexi:production:guard": "node scripts/guard-lexi-production-secrets.mjs",
    "lexi:production:dry-run": "node scripts/run-lexi-production-release-dry-run.mjs",
    "sudoku:seed-sql": "node scripts/generate-sudoku-seed.mjs",
    "lexi:prepare-wordlists": "node scripts/prepare-lexi-wordlists.mjs",
    "lexi:generate-server-lexicon": "node scripts/generate-lexi-server-lexicon.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@next/third-parties": "16.2.10",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "^26.0.0",
    "tailwindcss": "4.3.2",
    "typescript": "^5.9.0",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
